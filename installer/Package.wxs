<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PhotoPorter" Manufacturer="PhotoPorter" Version="1.1.0"
           UpgradeCode="6F1C2B7E-3D4A-4E5B-9C8D-1A2B3C4D5E6F" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer PhotoPorter is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="..\PhotoPorter.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PhotoPorter">
          <Component Id="MainExe" Guid="3B8E2F14-7C55-4D2A-A1E9-5F0C6D7B8A91">
            <File Id="PhotoPorterExe" Source="..\publish\PhotoPorter.exe" />
            <RegistryValue Root="HKCU" Key="Software\PhotoPorter" Name="exe" Type="integer" Value="1" KeyPath="yes" />
            <RemoveFolder Id="RmInstall" On="uninstall" />
            <RemoveFolder Id="RmPrograms" Directory="ProgramsDir" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut" Name="PhotoPorter" Target="[INSTALLFOLDER]PhotoPorter.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\PhotoPorter" Name="start" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DeskShortcut" Guid="*">
        <Shortcut Id="DesktopShortcut" Name="PhotoPorter" Target="[INSTALLFOLDER]PhotoPorter.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\PhotoPorter" Name="desk" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartShortcut" />
      <ComponentRef Id="DeskShortcut" />
    </Feature>
  </Package>
</Wix>


